# ==============================================================================
# VIRELO — Universal Media Downloader & Transcode Workstation
# Git Ignore Configuration
# ==============================================================================

# Node / Frontend Dependencies & Cache
node_modules/
frontend/node_modules/
.npm/
.yarn/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.turbo/
frontend/.vite/

# Python Virtual Environments & Bytecode
__pycache__/
*/__pycache__/
*/*/__pycache__/
*/*/*/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/

# User Media Storage & Ephemeral Cache (Preserve directories via .gitkeep)
downloads/*
!downloads/.gitkeep
backend/downloads/*
!backend/downloads/.gitkeep

# SQLite Databases & Ephemeral Logs
backend/data/*.db
backend/data/*.db-journal
backend/data/*.sqlite3
*.db
*.sqlite
*.sqlite3

# Local Environment Variables & Secrets
.env
.env.local
.env.*.local
!.env.example

# IDE & OS Generated Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
.idea/
.vscode/
*.swp
*.swo
*~
.agent/
